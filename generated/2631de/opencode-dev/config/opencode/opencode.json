  "plugin": [
    "oh-my-opencode-slim",
    "copilothydra",
    "opencode-vibeguard",
    "@melodyoftears/opencode-qwen-auth",
    "@tarquinen/opencode-dcp",
    "@slkiser/opencode-quota",
    "opencode-tokenspeed-monitor@latest",
    "@rama_nigg/open-cursor@github:Nomadcxx/opencode-cursor#main",
    "cursor-acp",
    "@zhafron/opencode-kiro-auth",
    "file:///opt/opencode-plugins/opencode-antigravity-auth/dist/index.js"
  ],
  "mcp": {
    "context7": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@upstash/context7-mcp"
      ],
      "environment": {
        "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}"
      }
    },
    "tavily": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "tavily-mcp"
      ],
      "environment": {
        "TAVILY_API_KEY": "{env:TAVILY_API_KEY}"
      }
    },
    "brave-search": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-brave-search"
      ],
      "environment": {
        "BRAVE_API_KEY": "{env:BRAVE_API_KEY}"
      }
    },
    "chrome-devtools": {
      "type": "local",
      "command": [
        "chrome-devtools-mcp",
        "--headless",
        "--isolated",
        "--executablePath=/usr/local/bin/opencode-browser",
        "--no-usage-statistics"
      ],
      "environment": {}
    },
    "playwright": {
      "type": "local",
      "command": [
        "playwright-mcp",
        "--headless",
        "--isolated",
        "--executable-path=/usr/local/bin/opencode-browser"
      ],
      "environment": {}
    },
    "browser": {
      "type": "local",
      "command": [
        "playwright-mcp",
        "--headless",
        "--isolated",
        "--executable-path=/usr/local/bin/opencode-browser",
        "--caps=vision,pdf,devtools"
      ],
      "environment": {}
    }
  },
  "permission": {
    "skill": "allow",
    "edit": "ask",
    "bash": "ask"
  }
}
