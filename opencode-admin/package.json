{
  "name": "opencode-admin",
  "version": "1.0.0",
  "description": "OpenCode Admin Control Plane - Beheerwebsite voor de OpenCode-stack",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/web",
    "apps/api"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:web\" \"npm run dev:api\"",
    "dev:web": "npm run dev -w apps/web",
    "dev:api": "npm run dev -w apps/api",
    "build": "npm run build:web && npm run build:api",
    "build:web": "npm run build -w apps/web",
    "build:api": "npm run build -w apps/api",
    "start": "npm run start -w apps/api",
    "lint": "npm run lint -w apps/web && npm run lint -w apps/api",
    "typecheck": "npm run typecheck -w apps/web && npm run typecheck -w apps/api",
    "clean": "rm -rf node_modules apps/*/node_modules apps/*/dist apps/*/.vite"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.4",
    "globals": "^16.5.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.0"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
